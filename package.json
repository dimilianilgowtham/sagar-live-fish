{
  "name": "sagar-live-fish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node --experimental-strip-types scripts/start-production.mjs",
    "owner:configure": "node --experimental-strip-types scripts/configure-owner.mjs",
    "db:backup": "node --experimental-strip-types scripts/backup-database.mjs",
    "qr:generate": "node --experimental-strip-types scripts/generate-shop-qr.mjs",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test src/lib/store.test.mjs tests/admin.test.mjs tests/catalogue-query.test.mjs tests/launch.test.mjs tests/admin-client.test.mjs tests/operations.test.mjs",
    "test:stress": "node --experimental-strip-types --test tests/database-stress.test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "check": "npm run lint && npm test && npm run test:stress && tsc --noEmit && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
