# Set to the website's real public origin before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Shared owner/catalogue database. Default: .data/sagar.sqlite in the project.
# Production: use a private, persistent disk and back it up.
# SAGAR_DATABASE_PATH=/var/lib/sagar/sagar.sqlite

# First production start on a new database only. Configure these as private
# hosting secrets. No owner password is bundled with the website.
# SAGAR_OWNER_LOGIN=owner
# SAGAR_OWNER_NAME=Sagar Live Fish
# SAGAR_OWNER_PASSWORD=<generate-a-unique-password-of-at-least-12-characters>

# Optional private backup directory on the persistent disk. Seven verified
# startup/daily snapshots are retained. Keep an encrypted off-site copy too.
# SAGAR_BACKUP_DIR=/var/lib/sagar/backups
